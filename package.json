{
  "name": "ant-lang",
  "displayName": "Ant",
  "description": "Ant language support: highlighting, editing defaults, the ant language server, and the ant debugger.",
  "version": "0.1.5",
  "publisher": "ant-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ant-src/vscode-ant.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "ant",
    "language"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ant",
    "onDebugResolve:ant",
    "onDebugDynamicConfigurations:ant"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The ant executable named by ant.path is used only in trusted workspaces, and Ant: Run File, Ant: Debug File and debugging are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "ant.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ant",
        "aliases": [
          "Ant",
          "ant"
        ],
        "extensions": [
          ".ant"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/ant.svg",
          "dark": "./images/ant_dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ant",
        "scopeName": "source.ant",
        "path": "./syntaxes/ant.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.css": "css"
        }
      },
      {
        "scopeName": "markdown.ant.codeblock",
        "path": "./syntaxes/ant.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ant": "ant"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "element",
        "superType": "type",
        "description": "An element of an HTML expression."
      },
      {
        "id": "attribute",
        "superType": "property",
        "description": "An attribute of an HTML expression."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ant",
        "scopes": {
          "element": [
            "entity.name.tag.ant"
          ],
          "attribute": [
            "entity.other.attribute-name.ant"
          ],
          "namespace": [
            "entity.name.namespace.ant"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[ant]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true
      }
    },
    "configuration": {
      "title": "Ant",
      "properties": {
        "ant.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `ant` executable. Empty means `ant` on `PATH`, then in `$GOBIN`, then in the `bin` directory of `go env GOPATH`."
        },
        "ant.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the Ant language server in the Ant output channel."
        }
      }
    },
    "commands": [
      {
        "command": "ant.restartServer",
        "title": "Restart Language Server",
        "category": "Ant"
      },
      {
        "command": "ant.showOutput",
        "title": "Show Server Output",
        "category": "Ant"
      },
      {
        "command": "ant.runFile",
        "title": "Run File",
        "category": "Ant",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "ant.debugFile",
        "title": "Debug File",
        "category": "Ant",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ant.runFile",
          "when": "editorLangId == ant"
        },
        {
          "command": "ant.debugFile",
          "when": "editorLangId == ant"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "ant",
        "owner": "ant",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "ant",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "The .ant file to run."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "ant"
      }
    ],
    "debuggers": [
      {
        "type": "ant",
        "label": "Ant",
        "languages": [
          "ant"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .ant file to run. A relative path is resolved against the workspace folder.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's arguments, as Os.args() returns them.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The working directory. Defaults to the program's directory. A relative path is resolved against the workspace folder."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables set over the editor's.",
                "default": {}
              },
              "stdin": {
                "type": "string",
                "description": "A file whose contents are the program's standard input. A relative path is resolved against the workspace folder."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement of the program's root module.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ant",
            "request": "launch",
            "name": "Debug Ant file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Ant: Launch",
            "description": "Debug an Ant program.",
            "body": {
              "type": "ant",
              "request": "launch",
              "name": "Debug Ant file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --minify",
    "compile": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap --watch",
    "test": "node --test test/grammar.test.mjs",
    "test:integration": "npm run compile && node test/integration/run.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vscode-languageclient": "^9.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
